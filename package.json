{
  "name": "qwen-coder-agent-studio",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered code editor with integrated terminal and agent chat",
  "author": "Jacob <jacob@example.com>",
  "homepage": "https://github.com/jacob/qwen-coder-agent-studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux deb"
  },
  "build": {
    "appId": "com.qwen-coder.agent-studio",
    "productName": "Qwen Coder Agent Studio",
    "linux": {
      "target": ["deb"],
      "category": "Development",
      "maintainer": "Jacob <jacob@example.com>",
      "icon": "icon.png"
    },
    "deb": {
      "synopsis": "AI-powered code editor with terminal"
    }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
